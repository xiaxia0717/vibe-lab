<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient"
    android:fitsSystemWindows="true">

    <!-- 顶部栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_icon_btn"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_back"
                android:contentDescription="返回" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="设置"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="28dp">

            <!-- ========== 连接 ========== -->
            <TextView
                style="@style/SectionTitle"
                android:text="连接" />

            <LinearLayout style="@style/CardBox">

                <LinearLayout style="@style/RowBox">
                    <TextView
                        style="@style/RowTitle"
                        android:text="电脑地址" />

                    <EditText
                        android:id="@+id/etHost"
                        style="@style/RowInput"
                        android:hint="127.0.0.1"
                        android:inputType="text"
                        android:importantForAutofill="no" />
                </LinearLayout>

                <View style="@style/Divider" />

                <LinearLayout style="@style/RowBox">
                    <TextView
                        style="@style/RowTitle"
                        android:text="端口" />

                    <EditText
                        android:id="@+id/etPort"
                        style="@style/RowInput"
                        android:hint="8080"
                        android:inputType="number"
                        android:importantForAutofill="no" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/HintText"
                android:text="用数据线连接时保持默认即可，不需要改。只有当手机和电脑在同一个 WiFi、需要填电脑局域网地址时才需要修改。" />

            <!-- ========== 默认画质 ========== -->
            <TextView
                style="@style/SectionTitle"
                android:text="默认画质" />

            <LinearLayout style="@style/CardBox">

                <LinearLayout style="@style/RowBox">
                    <TextView
                        style="@style/RowTitle"
                        android:text="分辨率" />

                    <Spinner
                        android:id="@+id/spinnerQuality"
                        style="@style/RowSpinner"
                        android:entries="@array/quality_options" />
                </LinearLayout>

                <View style="@style/Divider" />

                <LinearLayout style="@style/RowBox">
                    <TextView
                        style="@style/RowTitle"
                        android:text="帧率" />

                    <Spinner
                        android:id="@+id/spinnerFps"
                        style="@style/RowSpinner"
                        android:entries="@array/fps_options" />
                </LinearLayout>
            </LinearLayout>

            <!-- ========== 默认行为 ========== -->
            <TextView
                style="@style/SectionTitle"
                android:text="默认行为" />

            <LinearLayout style="@style/CardBox">

                <LinearLayout style="@style/RowBox">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/RowTitle"
                            android:text="自动开始" />
                        <TextView
                            style="@style/RowSub"
                            android:text="打开 App 后立即推流" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swAutoStart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View style="@style/Divider" />

                <LinearLayout style="@style/RowBox">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/RowTitle"
                            android:text="默认前置摄像头" />
                        <TextView
                            style="@style/RowSub"
                            android:text="关闭则默认用后置" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swPreferFront"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View style="@style/Divider" />

                <LinearLayout style="@style/RowBox">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/RowTitle"
                            android:text="麦克风默认开启" />
                        <TextView
                            style="@style/RowSub"
                            android:text="把手机麦克风传给电脑" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swMic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View style="@style/Divider" />

                <LinearLayout style="@style/RowBox">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/RowTitle"
                            android:text="扬声器默认开启" />
                        <TextView
                            style="@style/RowSub"
                            android:text="播放电脑传回的声音" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swSpeaker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <!-- ========== 恢复默认 ========== -->
            <TextView
                android:id="@+id/btnReset"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_btn_ghost"
                android:gravity="center"
                android:text="恢复默认设置"
                android:textColor="#C3CAD6"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                style="@style/HintText"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="手机摄像头 v1.0\n配合电脑端「启动.bat」使用" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
